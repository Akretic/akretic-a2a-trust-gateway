{
  "protocolVersion": "0.3",
  "name": "akretic-knowledge-agent",
  "description": "RAG DMZ-lite knowledge agent that filters synthetic corpus before model context.",
  "version": "0.1.0",
  "url": "http://127.0.0.1:8102",
  "supportedInterfaces": [
    {
      "url": "http://127.0.0.1:8102",
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "0.3"
    }
  ],
  "provider": {
    "organization": "Akretic",
    "url": "https://akretic.com"
  },
  "documentationUrl": "https://akretic.com/a2a-trust-gateway-demo",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false
  },
  "securitySchemes": {
    "demo-header": {
      "apiKeySecurityScheme": {
        "description": "Derived demo identity header; request-body claims are not trusted.",
        "location": "header",
        "name": "x-akretic-persona"
      }
    }
  },
  "defaultInputModes": [
    "application/json"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "authentication": {
    "schemes": [
      "demo-header"
    ],
    "notes": "P0 demo uses derived persona headers; do not trust body claims."
  },
  "skills": [
    {
      "id": "retrieve_permitted_context",
      "name": "retrieve_permitted_context",
      "description": "Return only permitted corpus chunks.",
      "tags": [
        "retrieval",
        "pre-context-filtering"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ]
    },
    {
      "id": "list_sources",
      "name": "list_sources",
      "description": "List synthetic source metadata.",
      "tags": [
        "retrieval",
        "metadata"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ]
    },
    {
      "id": "redact_context",
      "name": "redact_context",
      "description": "Support context minimization for permitted chunks.",
      "tags": [
        "retrieval",
        "minimization"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ]
    }
  ]
}

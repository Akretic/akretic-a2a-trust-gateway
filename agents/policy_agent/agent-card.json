{
  "protocolVersion": "0.3",
  "name": "akretic-policy-agent",
  "description": "Gate0-lite deterministic policy agent for allow, deny, and approval_required decisions.",
  "version": "0.1.0",
  "url": "http://127.0.0.1:8101",
  "supportedInterfaces": [
    {
      "url": "http://127.0.0.1:8101",
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "0.3"
    }
  ],
  "provider": {
    "organization": "Akretic",
    "url": "https://akretic.com"
  },
  "documentationUrl": "https://akretic.com/a2a-trust-gateway-demo",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false
  },
  "securitySchemes": {
    "demo-header": {
      "apiKeySecurityScheme": {
        "description": "Derived demo identity header; request-body claims are not trusted.",
        "location": "header",
        "name": "x-akretic-persona"
      }
    }
  },
  "defaultInputModes": [
    "application/json"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "authentication": {
    "schemes": [
      "demo-header"
    ],
    "notes": "P0 demo uses derived persona headers; do not trust body claims."
  },
  "skills": [
    {
      "id": "authorize_intent",
      "name": "authorize_intent",
      "description": "Evaluate actor/action/resource/context.",
      "tags": [
        "policy",
        "authorization"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ]
    },
    {
      "id": "classify_resource",
      "name": "classify_resource",
      "description": "Return demo resource classification.",
      "tags": [
        "policy",
        "classification"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ]
    },
    {
      "id": "explain_decision",
      "name": "explain_decision",
      "description": "Explain deterministic policy decision.",
      "tags": [
        "policy",
        "explainability"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ]
    }
  ]
}
